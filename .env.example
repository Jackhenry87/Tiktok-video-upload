# ---------------------------------------------------------------------------
# TikTok Video Automation — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- ViewMax (video generation connector) ----------------------------------
# TODO(real-api): set these once you receive your ViewMax API credentials/docs.
VIEWMAX_API_KEY=
VIEWMAX_BASE_URL=
# Discover valid ids with `npm run viewmax-catalog`.
VIEWMAX_STYLE_PRESET=style-bold-captions
VIEWMAX_VOICE_PRESET=voice-alex

# --- TikTok official Content Posting API ------------------------------------
# 1. Create an app at https://developers.tiktok.com (Content Posting API
#    product, video.publish scope) and register your redirect URI there.
# 2. Put the client key/secret + redirect URI here.
# 3. Run `npm run tiktok-auth` — tokens are stored and auto-refresh.
# TIKTOK_ACCESS_TOKEN is optional (static fallback; expires ~24h after issue).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8787/callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_SCOPES=video.publish

# --- Storage -----------------------------------------------------------------
# SQLite database location. "file:" prefix optional.
DATABASE_URL=file:./data/app.db
# Where generated videos / thumbnails / drafts are stored.
STORAGE_DIR=./storage

# --- Content settings ---------------------------------------------------------
# One of the configured niches (see src/config/appConfig.ts), e.g.:
# sports betting | finance | side hustles | real estate | ai tools |
# college life | fitness | local business marketing
DEFAULT_NICHE=finance
# Comma-separated list to generate for multiple niches at once (optional).
NICHES=

# SELF_ONLY is the safe default (unaudited TikTok apps can only post SELF_ONLY).
# Options: SELF_ONLY | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE
DEFAULT_PRIVACY_STATUS=SELF_ONLY

# --- Safety & compliance -------------------------------------------------------
MAX_DAILY_UPLOADS=3
# Keep true: every video must be manually approved before upload.
REVIEW_REQUIRED=true
# Trends scoring 0-100; only trends at/above this score become videos.
MIN_TREND_SCORE=55

# --- Scheduling ----------------------------------------------------------------
TIMEZONE=America/Chicago
# Local-time posting slots used by `npm run schedule`.
POSTING_TIMES=09:00,13:00,19:00

# --- Trend sources (all optional; approved sources only) -------------------------
# Path to a user-provided trend CSV (see examples/trends.example.csv).
TREND_CSV_PATH=
# Comma-separated RSS feed URLs you are allowed to use for trend signals.
RSS_FEEDS=
# Path to a Google Trends CSV export (manual download from trends.google.com).
GOOGLE_TRENDS_CSV_PATH=

# --- Runtime ----------------------------------------------------------------------
# true  = fully mocked (fake trends, fake video jobs, no real uploads).
# false = real APIs required; commands fail with a setup message if keys missing.
# unset = auto: uses real APIs when configured, falls back to mock with a notice.
MOCK_MODE=true
LOG_LEVEL=info
